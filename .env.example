# Copy this file to .env. Keep API credentials on the server; never put them in app.js.
PORT=5000
DETECTIFAI_API_KEY=
DETECTIFAI_DEEPFAKE_URL=
DETECTIFAI_SPEAKER_URL=
# Optional API-specific header name and prefix, if DetectifAI's docs require them.
DETECTIFAI_AUTH_HEADER=Authorization
DETECTIFAI_AUTH_PREFIX=Bearer
